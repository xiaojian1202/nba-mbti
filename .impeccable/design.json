      "css": ".ds-progress{width:91.6%;height:5px;appearance:none;border:0;background:#3a4851;display:block}.ds-progress::-webkit-progress-bar{background:#3a4851}.ds-progress::-webkit-progress-value{background:var(--orange)}.ds-progress::-moz-progress-bar{background:var(--orange)}@media(max-width:700px){.ds-progress{width:90%}}"
