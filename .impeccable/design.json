  "narrative": {
    "northStar": "The Scouting Report",
    "overview": "Court Type feels like a basketball scouting sheet brought onto a lit court: cool concourse slate and deep ink frame decisive orange marks. The landing page gives a court photograph half the hero, the quiz turns the canvas dark, and the result uses a broad orange code panel beside an ink report. These are shipped surface expressions of the same palette and typography.\n\nThe visual rhythm is forceful but spare. Condensed, heavy headlines carry the hierarchy; quiet body copy and thin rules make the information readable. Flat color fields and square controls give the screens their structure.",
    "keyCharacteristics": [
      "Cool slate, dark ink, and vivid orange have distinct roles.",
      "Large condensed headlines pair with calm sans-serif reading text.",
      "Split fields, visible rules, and full-width answer rows organize content.",
      "A single basketball photograph anchors the landing view."
    ],
    "rules": [
      {
        "name": "The Signal Rule",
        "body": "Orange marks the action or decisive piece of information; the larger slate and ink fields carry the page.",
        "section": "colors"
      },
      {
        "name": "The Two-Voice Rule",
        "body": "Use Barlow Condensed for emphasis, actions, and compact data; use DM Sans for explanatory text.",
        "section": "typography"
      },
      {
        "name": "The Flat Court Rule",
        "body": "Separate planes with color and rules, not shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use broad slate or ink fields with orange for the next action or a key finding.",
      "Do let condensed type and visible rules create the report hierarchy.",
      "Do keep quiz choices as large, full-width rows with a clear selected state."
    ],
    "donts": [
      "Don't add drop shadows to established flat panels and controls.",
      "Don't round the square action buttons or answer rows.",
      "Don't use the display face for long reading passages."
    ]
  }
}
