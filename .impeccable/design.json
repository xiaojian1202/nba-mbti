  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Orange action used to start, continue, and share.",
      "html": "<button class=\"ds-btn-primary\">Find my court type</button>",
      "css": ".ds-btn-primary{border:0;border-radius:0;background:var(--orange);color:var(--ink);padding:17px 22px;min-height:58px;display:inline-flex;align-items:center;justify-content:space-between;gap:36px;font:800 22px/1 \"Barlow Condensed\",sans-serif;letter-spacing:.02em;cursor:pointer;transition:background .2s ease,transform .2s ease}.ds-btn-primary:hover{background:#ff8154;transform:translateY(-2px)}.ds-btn-primary:focus-visible{outline:3px solid var(--orange);outline-offset:4px}.ds-btn-primary:disabled{opacity:.4;cursor:not-allowed;transform:none}@media(prefers-reduced-motion:reduce){.ds-btn-primary{transition:none}}"
    },
    {
      "name": "Text Action",
      "kind": "button",
      "description": "Underlined return action paired with a primary button.",
      "html": "<button class=\"ds-text-action\">Previous question</button>",
      "css": ".ds-text-action{background:transparent;border:0;color:#c2cacc;padding:12px 0;text-decoration:underline;text-underline-offset:5px;font:400 16px/1.4 \"DM Sans\",sans-serif;cursor:pointer}.ds-text-action:hover{color:#fff}.ds-text-action:focus-visible{outline:3px solid var(--orange);outline-offset:4px}"
    },
    {
      "name": "Brand Navigation",
      "kind": "nav",
      "description": "Basketball-line mark and condensed wordmark in the site header.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-brand\" aria-label=\"Court Type home\"><svg class=\"ds-ball\" viewBox=\"0 0 40 40\" fill=\"none\" aria-hidden=\"true\"><circle cx=\"20\" cy=\"20\" r=\"18\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M2 20h36M20 2v36M6.5 8.5c7.5 5 9.5 12 9.5 23M33.5 8.5c-7.5 5-9.5 12-9.5 23\" stroke=\"currentColor\" stroke-width=\"2\"/></svg><span>COURT<span class=\"ds-slash\">/</span>TYPE</span></button></nav>",
      "css": ".ds-nav{height:80px;padding:0 4.2%;display:flex;align-items:center;border-bottom:1px solid var(--ink);background:var(--concourse);color:var(--ink)}.ds-brand{display:inline-flex;align-items:center;gap:12px;border:0;background:transparent;color:inherit;padding:0;font:800 27px/1 \"Barlow Condensed\",sans-serif;letter-spacing:.01em;cursor:pointer}.ds-ball{width:31px;height:31px;color:var(--orange)}.ds-slash{color:var(--orange)}.ds-brand:focus-visible{outline:3px solid var(--orange);outline-offset:4px}@media(max-width:700px){.ds-nav{height:64px;padding:0 5%}.ds-brand{font-size:23px;gap:9px}.ds-ball{width:26px;height:26px}}"
    },
    {
      "name": "Quiz Choice",
      "kind": "button",
      "refersTo": "choice",
      "description": "Full-width answer row with a letter marker and circular selection state.",
      "html": "<button class=\"ds-choice\" aria-pressed=\"false\"><span class=\"ds-choice-letter\">A</span><span class=\"ds-choice-text\">Take the open lane and finish.</span><span class=\"ds-choice-indicator\" aria-hidden=\"true\"></span></button>",
      "css": ".ds-choice{width:100%;padding:22px 24px;min-height:90px;display:flex;align-items:center;gap:25px;color:var(--concourse);background:#1d2a36;border:1px solid #56636c;text-align:left;cursor:pointer;transition:border-color .2s ease,background .2s ease}.ds-choice:hover,.ds-choice[aria-pressed=\"true\"]{border-color:var(--orange);background:#273643}.ds-choice:focus-visible{outline:3px solid var(--orange);outline-offset:4px}.ds-choice-letter{font:700 26px/1 \"Barlow Condensed\",sans-serif;color:var(--orange);width:30px;flex:none}.ds-choice-text{font:400 17px/1.4 \"DM Sans\",sans-serif;flex:1}.ds-choice-indicator{width:21px;height:21px;border:1px solid #7e8e96;border-radius:50%;flex:none}.ds-choice[aria-pressed=\"true\"] .ds-choice-indicator{border:6px solid var(--orange)}@media(max-width:700px){.ds-choice{padding:17px;min-height:82px;gap:16px}.ds-choice-letter{font-size:23px;width:24px}.ds-choice-text{font-size:16px}}@media(prefers-reduced-motion:reduce){.ds-choice{transition:none}}"
    },
